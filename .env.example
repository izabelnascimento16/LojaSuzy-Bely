# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign session tokens on the server.
SESSION_SECRET=

# ADMIN_ACCESS_PASSCODE: Optional passcode for store owner admin access.
# If left empty, the first-run setup form on the Admin tab lets you claim your owner password.
ADMIN_ACCESS_PASSCODE=

# MERCADOPAGO_ACCESS_TOKEN: Optional Mercado Pago server access token for live PIX/Card payments.
MERCADOPAGO_ACCESS_TOKEN=

# SMTP_* : Optional SMTP credentials for automatic transactional emails (account welcome, order confirmation, password reset).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

